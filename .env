# Supabase Project Credentials (Found in Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Use Service Role Key for full storage & table management, or Anon Key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_KEY=your-supabase-anon-key-here

# Supabase Storage & Table Names
SUPABASE_BUCKET=images
SUPABASE_TABLE=images

# Server Port (Render sets this automatically)
PORT=5000
